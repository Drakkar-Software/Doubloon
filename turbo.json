{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@drakkar.software/starfish-client#build": { "dependsOn": [], "outputs": ["dist/**"] },
    "@drakkar.software/starfish-protocol#build": { "dependsOn": [], "outputs": ["dist/**"] },
    "@drakkar.software/starfish-entitlements#build": { "dependsOn": [], "outputs": ["dist/**"] },
    "@drakkar.software/starfish-server#build": { "dependsOn": [], "outputs": ["dist/**"] },
    "@drakkar.software/starfish-keyring#build": { "dependsOn": [], "outputs": ["dist/**"] },
    "@drakkar.software/starfish-identities#build": { "dependsOn": [], "outputs": ["dist/**"] },
    "@drakkar.software/starfish-sharing#build": { "dependsOn": [], "outputs": ["dist/**"] },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
